{
  "name": "endurance-canvas-backend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/app.js && node --check src/config.js && node --check src/creator.js && node --check src/quotas.js && node --check src/generation.js && node --check contracts/validation.js"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.15",
    "ai": "7.0.162",
    "better-auth": "1.7.15",
    "express": "5.3.0",
    "mongodb": "7.8.0"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  }
}
