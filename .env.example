NODE_ENV=development
HOST=127.0.0.1
PORT=4000
AI_MODE=demo
# Required for production. Use the same server-only value in the frontend proxy.
BACKEND_SERVICE_TOKEN=
# Optional live mode; configure a currently available model before switching.
AI_GATEWAY_API_KEY=
AI_MODEL_ID=
GENERATION_TIMEOUT_MS=25000
GENERATION_MAX_PER_MINUTE=12
GENERATION_MAX_CONCURRENT=2
AI_MAX_OUTPUT_TOKENS=2500
