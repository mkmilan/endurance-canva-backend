NODE_ENV=development
HOST=127.0.0.1
PORT=4000
AI_MODE=demo
# Required for production. Use the same server-only value in the frontend proxy.
BACKEND_SERVICE_TOKEN=
# Live requests require an owner session, database quota reservation, and these
# settings. Missing credentials leave live AI unavailable; demo stays usable.
AI_GATEWAY_API_KEY=
AI_MODEL_ID=
GENERATION_TIMEOUT_MS=25000
GENERATION_MAX_PER_MINUTE=12
GENERATION_MAX_CONCURRENT=2
AI_MAX_OUTPUT_TOKENS=2500
AI_DAILY_REQUEST_LIMIT=20
AI_MONTHLY_REQUEST_LIMIT=200
# Creator access: keep all credentials on the Render backend only.
MONGODB_URI=
MONGODB_DATABASE=endurance_canvas
# Per connection/server-selection/socket/pool-wait phase and app operation,
# not a total transaction deadline. Driver transaction retries can take 120s.
MONGODB_TIMEOUT_MS=8000
AUTH_SECRET=
STUDIO_ORIGIN=http://127.0.0.1:3000
# SHA256 of a random one-time setup token, never the raw token. Setup closes
# once the owner exists. Use an ISO8601 expiry, such as a time 24 hours from now.
OWNER_SETUP_TOKEN_HASH=
OWNER_SETUP_EXPIRES_AT=
